// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model Employee {
  id   Int      @id @default(autoincrement())
  Firstname  String
  Lastname   String
  PhotoURL   String?
  User       User?
  Availability Availability[]
  ScheduleAssignment ScheduleAssignment[]
}

model User {
  id         Int     @id @default(autoincrement())
  Role       Role    @default(EMPLOYEE)
  EmployeeID Int     @unique
  Employee   Employee @relation(fields: [EmployeeID], references: [id])
  LoginCode  String
  Email      String   @unique

}

model Shifts {
  id   Int      @id @default(autoincrement())
  ShiftName  String
  StartTime  DateTime
  EndTime    DateTime
  Availability Availability[]
  ScheduleEntry ScheduleEntry[]
}

model Availability {
  id   Int      @id @default(autoincrement())
  Day        DateTime
  ShiftID    Int
  Shift      Shifts   @relation(fields: [ShiftID], references: [id])
  Available  Boolean
  EmployeeID Int
  Employee   Employee @relation(fields: [EmployeeID], references: [id])


  @@unique([EmployeeID, ShiftID, Day]) //This avoids creating more conflicting availability per day/shift/employee
}

model ScheduleEntry {
  id   Int      @id @default(autoincrement())
  Day        DateTime
  ShiftID    Int
  Shift      Shifts   @relation(fields: [ShiftID], references: [id])
  ScheduleAssignment ScheduleAssignment[]

  @@unique([ShiftID, Day])// This avoids creating more than one of the three shifts per day
}

model ScheduleAssignment {
  id        Int      @id @default(autoincrement())
  ScheduleEntryID Int
  ScheduleEntry   ScheduleEntry @relation(fields: [ScheduleEntryID], references: [id])
  EmployeeID      Int
  Employee        Employee @relation(fields: [EmployeeID], references: [id])

  @@unique([ScheduleEntryID, EmployeeID]) // This avoids double-scheduling an employee twice on the same shift.
}