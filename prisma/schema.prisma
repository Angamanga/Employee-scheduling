// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  UniqueID   Int      @id @default(autoincrement())
  Firstname  String
  Lastname   String
  Email      String   @unique
  LoginCode  String
  PhotoURL   String?
  User       User?
  Availability Availability[]
  ScheduleAssignment ScheduleAssignment[]
}

model Roles {
  UniqueID Int    @id @default(autoincrement())
  RoleName String @unique
  User     User[]
}

model User {
  UniqueID   Int     @id @default(autoincrement())
  RoleID     Int
  Role       Roles   @relation(fields: [RoleID], references: [UniqueID])
  EmployeeID Int     @unique
  Employee   Employee @relation(fields: [EmployeeID], references: [UniqueID])
}

model Shifts {
  UniqueID   Int      @id @default(autoincrement())
  ShiftName  String
  StartTime  DateTime
  EndTime    DateTime
  Availability Availability[]
  ScheduleEntry ScheduleEntry[]
}

model Availability {
  UniqueID   Int      @id @default(autoincrement())
  Day        DateTime
  ShiftID    Int
  Shift      Shifts   @relation(fields: [ShiftID], references: [UniqueID])
  Available  Boolean
  EmployeeID Int
  Employee   Employee @relation(fields: [EmployeeID], references: [UniqueID])


  @@unique([EmployeeID, ShiftID, Day]) //This avoids creating more conflicting availability per day/shift/employee
}

model ScheduleEntry {
  UniqueID   Int      @id @default(autoincrement())
  Day        DateTime
  ShiftID    Int
  Shift      Shifts   @relation(fields: [ShiftID], references: [UniqueID])
  ScheduleAssignment ScheduleAssignment[]

  @@unique([ShiftID, Day])// This avoids creating more than one of the three shifts per day
}

model ScheduleAssignment {
  UniqueID        Int      @id @default(autoincrement())
  ScheduleEntryID Int
  ScheduleEntry   ScheduleEntry @relation(fields: [ScheduleEntryID], references: [UniqueID])
  EmployeeID      Int
  Employee        Employee @relation(fields: [EmployeeID], references: [UniqueID])

  @@unique([ScheduleEntryID, EmployeeID]) // This avoids double-scheduling an employee twice on the same shift.
}